# Timezone all class times are scheduled in.
ACADEMY_TIMEZONE=Europe/Amsterdam

# Seeded demo accounts (<handle>@academe.demo). Defaults to academe-demo in dev;
# in production, leave unset (seeded accounts can't sign in) or use a strong value.
# DEMO_PASSWORD=

# One-click demo sign-in. On in dev, off in production unless set to true.
# Only for throwaway demo deployments: it lets anyone sign in as the admin.
# DEMO_LOGIN=true

# Phase 2.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# RESEND_API_KEY=
# Automatic Zoom meetings for new classes (Server-to-Server OAuth app).
# ZOOM_ACCOUNT_ID=
# ZOOM_CLIENT_ID=
# ZOOM_CLIENT_SECRET=
