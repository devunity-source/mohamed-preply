# Timezone all class times are scheduled in.
ACADEMY_TIMEZONE=Asia/Dubai

# Seeded demo accounts (<handle>@academe.demo). Defaults to academe-demo in dev;
# in production, leave unset (seeded accounts can't sign in) or use a strong value.
# DEMO_PASSWORD=

# One-click demo sign-in. On in dev, off in production unless set to true.
# Only for throwaway demo deployments: it lets anyone sign in as the admin.
# DEMO_LOGIN=true

# Supabase (see docs/supabase-setup.md). Leave both NEXT_PUBLIC_ values unset
# for demo mode: sign-in and data held in memory.
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server only, never public: lets admins invite students.
# SUPABASE_SECRET_KEY=sb_secret_...
# Where the app is reached; links in emails point here.
# SITE_URL=http://localhost:3000

# Later in Phase 2.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# RESEND_API_KEY=
# Automatic Zoom meetings for new classes (Server-to-Server OAuth app).
# ZOOM_ACCOUNT_ID=
# ZOOM_CLIENT_ID=
# ZOOM_CLIENT_SECRET=
