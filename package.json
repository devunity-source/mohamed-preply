{
  "name": "academe",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write src",
    "typecheck": "next typegen && tsc --noEmit",
    "test:db": "node supabase/tests/rls.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test": "npm run test:db && npm run test:e2e",
    "db:bundle": "node scripts/bundle-migrations.mjs",
    "db:seed": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/seed-curriculum.ts",
    "test:e2e:supabase": "bash scripts/e2e-supabase.sh",
    "db:check": "tsx --env-file-if-exists=.env.local scripts/check-supabase.ts",
    "email:test": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/send-test-email.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.47.0",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
